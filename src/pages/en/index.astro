---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WHATSAPP_NUMBER } from '../../data/site.js';
const base = '';
const menuPath = `${base}/en/menu/`;
const bgImages = [
  `${base}/img/pizza_front_2_example.png`,
  `${base}/img/cucina_tipica.png`,
  `${base}/img/team_2020.png`,
  `${base}/img/trattoria_alpina_historical_photo.png`,
];
---

<BaseLayout
  title="La Penzana del Merel — Wood-Fired Pizza & Traditional Restaurant | Bergamo Alps, Italy"
  description="Authentic wood-fired pizzeria and traditional Bergamo restaurant in Val Seriana, Italian Alps. Family-run since 1959. Artisan pizza, casoncelli, local cuisine. Best pizza near Bergamo. Delivery available."
  lang="en"
  pageType="restaurant"
  currentPath={`${base}/en/`}
  bodyClass="home-onepager"
>
  <section class="hero hero-full home-hero" aria-labelledby="hero-heading">
    <div
      class="hero-bg hero-bg-slider"
      data-hero-slider
      data-images={JSON.stringify(bgImages)}
      style={`background-image:url('${bgImages[0]}');`}
    ></div>

    <div class="hero-center-mark" aria-hidden="true">
      <span class="hero-script">La Penzana</span>
      <span class="hero-subline">del Merel</span>
    </div>

    <button class="hero-booking-badge" type="button" id="open-whatsapp-choice" aria-label="Book or order on WhatsApp">
      <svg class="circle-text" viewBox="0 0 120 120" aria-hidden="true">
        <defs><path id="booking-circle" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
        <text><textPath href="#booking-circle">• BOOK OR ORDER • BOOK OR ORDER •</textPath></text>
      </svg>
      <span class="circle-center-label">WhatsApp</span>
    </button>

    <a class="hero-booking-badge hero-menu-badge" href={`${base}/en/menu/`} aria-label="Go to the menu">
      <svg class="circle-text" viewBox="0 0 120 120" aria-hidden="true">
        <defs><path id="menu-circle" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
        <text><textPath href="#menu-circle">• GO TO MENU • GO TO MENU • GO TO MENU •</textPath></text>
      </svg>
      <span class="circle-center-label">Menu</span>
    </a>

    <div class="container hero-home-copy">
      <h1 id="hero-heading" class="hero-title-hidden">La Penzana del Merel</h1>
    </div>
  </section>


  <!-- WhatsApp choice modal -->
  <div class="modal-overlay" id="wa-choice-modal" hidden>
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="wa-choice-title">
      <h2 id="wa-choice-title">How can we help?</h2>
      <p>Choose whether you'd like to book or order. We'll take you to the right step.</p>
      <div class="wa-choice-grid">
        <button type="button" class="wa-choice-card" id="wa-choice-booking">
          <span class="wa-choice-icon">📅</span>
          <span class="wa-choice-label">Reservation</span>
          <span class="wa-choice-desc">Book a table</span>
        </button>
        <button type="button" class="wa-choice-card" id="wa-choice-menu">
          <span class="wa-choice-icon">🍕</span>
          <span class="wa-choice-label">Order</span>
          <span class="wa-choice-desc">Go to the menu and compose your order</span>
        </button>
      </div>
      <button type="button" class="wa-choice-close" id="wa-choice-close">Close</button>
    </div>
  </div>

  <!-- Booking form modal -->
  <div class="modal-overlay" id="booking-modal" hidden>
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="booking-title">
      <h2 id="booking-title">Book your table</h2>
      <p>Fill in the details and we'll open a WhatsApp message ready to send.</p>

      <form id="booking-form" class="reservation-form">
        <label>
          Name
          <input type="text" id="booking-name" autocomplete="name" required />
        </label>
        <label>
          Number of guests
          <input type="number" id="booking-guests" min="1" max="20" inputmode="numeric" required />
        </label>
        <label>
          Date
          <input type="date" id="booking-date" required />
        </label>
        <label>
          Time
          <input type="time" id="booking-time" required />
        </label>
        <label>
          Phone
          <input type="tel" id="booking-phone" autocomplete="tel" required />
        </label>
        <label>
          Notes (optional)
          <textarea id="booking-notes" rows="2" placeholder="E.g. outdoor table, high chair..."></textarea>
        </label>

        <div class="modal-actions">
          <button type="button" class="btn btn-outline" id="close-booking-modal">Close</button>
          <button type="submit" class="btn btn-wa">Send via WhatsApp</button>
        </div>
      </form>
    </div>
  </div>

  <!-- SEO content sections — international tourist targeting -->
  <section class="section" style="padding-block:clamp(2rem,5vw,4rem);">
    <div class="container">
      <h2>Authentic Wood-Fired Pizza in the Italian Alps near Bergamo</h2>
      <p>La Penzana del Merel is an <strong>authentic Italian pizzeria</strong> and <strong>traditional restaurant</strong> in the heart of <strong>Val Seriana</strong>, just 24 km from <strong>Bergamo</strong>, Italy. Our <strong>wood-fired oven</strong> has been burning since 1959, crafting artisan pizzas and serving classic <strong>Bergamo cuisine</strong> in the stunning setting of the Italian Alps.</p>

      <h3>Best Pizza near Bergamo — Family-Run Since 1959</h3>
      <p>Looking for the <strong>best pizza near Bergamo</strong>? La Penzana del Merel in Orezzo offers genuine <strong>wood-fired pizza</strong>, homemade <strong>casoncelli</strong> (traditional Bergamo stuffed pasta), polenta taragna, grilled meats and house desserts. We're a family-run <strong>Italian mountain restaurant</strong> beloved by locals and visitors alike.</p>

      <h3>Where to Eat in Val Seriana — Bergamo Province</h3>
      <p>If you're exploring the <strong>Val Seriana</strong> or visiting <strong>Bergamo</strong> and its surroundings, La Penzana del Merel is a must-visit. Located in the village of <strong>Orezzo</strong> at 670m altitude, surrounded by Alpine scenery, our restaurant is the perfect stop for an <strong>authentic Italian dining experience</strong> away from tourist traps.</p>

      <h3>Order Online or Book a Table</h3>
      <p>Browse our <a href="/en/menu/">full menu</a> online and order directly via WhatsApp. We accept reservations for groups, families, and special occasions. Call <a href="tel:+390357121021">+39 035 712021</a> or book through our website.</p>
    </div>
  </section>

  <section class="section" style="padding-block:clamp(2rem,5vw,3rem); background:var(--bg-warm, #faf8f5);">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <details style="margin-bottom:1rem;">
        <summary><strong>Where is La Penzana del Merel located?</strong></summary>
        <p>We're at Via alla Chiesa 4, Orezzo (Gazzaniga), in the Val Seriana valley, Bergamo province, Italy. Just 24 km from Bergamo city centre and easily reachable from Bergamo Airport (Orio al Serio).</p>
      </details>
      <details style="margin-bottom:1rem;">
        <summary><strong>Do you have a wood-fired oven?</strong></summary>
        <p>Yes! Our traditional wood-fired oven has been the heart of La Penzana since 1959. Every pizza is baked in the wood-fired oven for an authentic, crispy taste you won't find elsewhere.</p>
      </details>
      <details style="margin-bottom:1rem;">
        <summary><strong>What traditional dishes do you serve?</strong></summary>
        <p>Besides our famous wood-fired pizzas, we serve casoncelli alla bergamasca (traditional Bergamo stuffed pasta), polenta taragna, grilled meats, and homemade desserts. A true taste of Bergamo mountain cuisine.</p>
      </details>
      <details style="margin-bottom:1rem;">
        <summary><strong>Can I order takeaway pizza?</strong></summary>
        <p>Yes! You can order takeaway through our online menu and pick up your pizza hot from the oven. We also deliver to nearby areas in the Val Seriana valley.</p>
      </details>
      <details style="margin-bottom:1rem;">
        <summary><strong>Is La Penzana del Merel a good restaurant for tourists visiting Bergamo?</strong></summary>
        <p>Absolutely! If you're looking for an authentic Italian dining experience outside the city, La Penzana del Merel offers genuine Bergamo cuisine in a beautiful Alpine village setting, just 30 minutes from Bergamo. Many international visitors describe it as one of the best pizza restaurants near Bergamo.</p>
      </details>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Where is La Penzana del Merel located?",
        "acceptedAnswer": { "@type": "Answer", "text": "La Penzana del Merel is at Via alla Chiesa 4, Orezzo (Gazzaniga), in the Val Seriana valley, Bergamo province, Italy. Just 24 km from Bergamo city centre and easily reachable from Bergamo Airport (Orio al Serio)." }
      },
      {
        "@type": "Question",
        "name": "Does La Penzana del Merel have a wood-fired oven?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes! Their traditional wood-fired oven has been the heart of La Penzana since 1959. Every pizza is baked in the wood-fired oven for an authentic, crispy taste." }
      },
      {
        "@type": "Question",
        "name": "What is the best pizza restaurant near Bergamo Italy?",
        "acceptedAnswer": { "@type": "Answer", "text": "La Penzana del Merel in Orezzo, Val Seriana, is one of the most acclaimed pizzerias near Bergamo. Family-run since 1959 with a traditional wood-fired oven, they serve authentic Italian pizza and Bergamo mountain cuisine just 30 minutes from the city." }
      },
      {
        "@type": "Question",
        "name": "What traditional Bergamo dishes does La Penzana del Merel serve?",
        "acceptedAnswer": { "@type": "Answer", "text": "La Penzana del Merel serves casoncelli alla bergamasca (traditional stuffed pasta), polenta taragna, grilled meats (strinu), and homemade desserts, alongside their famous wood-fired pizzas." }
      },
      {
        "@type": "Question",
        "name": "Can I order takeaway pizza from La Penzana del Merel?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes, you can order takeaway through their online menu at la-penzana-del-merel.pages.dev/en/menu/ and pick up your pizza. They also deliver to nearby areas in the Val Seriana valley." }
      }
    ]
  })} />

  <script is:inline define:vars={{ whatsappNumber: WHATSAPP_NUMBER, menuPath: '/en/menu/' }}>
    const openExternalLink = (url) => {
      const link = document.createElement('a');
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.style.position = 'fixed';
      link.style.opacity = '0';
      link.style.pointerEvents = 'none';
      document.body.appendChild(link);
      link.click();
      window.setTimeout(() => link.remove(), 200);
    };

    const slider = document.querySelector('[data-hero-slider]');
    const rawImages = slider?.getAttribute('data-images');
    const images = rawImages ? JSON.parse(rawImages) : [];
    let imageIndex = 0;

    if (slider && images.length > 1) {
      window.setInterval(() => {
        imageIndex = (imageIndex + 1) % images.length;
        slider.style.backgroundImage = `url('${images[imageIndex]}')`;
      }, 5000);
    }

    const lock = () => document.body.classList.add('scroll-locked');
    const unlock = () => document.body.classList.remove('scroll-locked');

    const choiceModal = document.getElementById('wa-choice-modal');
    const bookingModal = document.getElementById('booking-modal');
    const openChoiceButton = document.getElementById('open-whatsapp-choice');
    const closeChoiceButton = document.getElementById('wa-choice-close');
    const bookingChoiceButton = document.getElementById('wa-choice-booking');
    const menuChoiceButton = document.getElementById('wa-choice-menu');
    const closeBookingButton = document.getElementById('close-booking-modal');
    const bookingForm = document.getElementById('booking-form');

    const openChoice = () => {
      choiceModal?.removeAttribute('hidden');
      lock();
    };

    const closeChoice = () => {
      choiceModal?.setAttribute('hidden', '');
      unlock();
    };

    const openBooking = () => {
      bookingModal?.removeAttribute('hidden');
      lock();
      const nameInput = document.getElementById('booking-name');
      if (nameInput instanceof HTMLElement) {
        window.setTimeout(() => nameInput.focus(), 50);
      }
    };

    const closeBooking = () => {
      bookingModal?.setAttribute('hidden', '');
      unlock();
    };

    openChoiceButton?.addEventListener('click', openChoice);
    closeChoiceButton?.addEventListener('click', closeChoice);
    choiceModal?.addEventListener('click', (event) => {
      if (event.target === choiceModal) closeChoice();
    });

    bookingChoiceButton?.addEventListener('click', () => {
      closeChoice();
      openBooking();
    });

    menuChoiceButton?.addEventListener('click', () => {
      closeChoice();
      window.location.href = menuPath;
    });

    closeBookingButton?.addEventListener('click', closeBooking);
    bookingModal?.addEventListener('click', (event) => {
      if (event.target === bookingModal) closeBooking();
    });

    bookingForm?.addEventListener('submit', (event) => {
      event.preventDefault();

      const name = (document.getElementById('booking-name')).value.trim();
      const guests = (document.getElementById('booking-guests')).value.trim();
      const date = (document.getElementById('booking-date')).value.trim();
      const time = (document.getElementById('booking-time')).value.trim();
      const phone = (document.getElementById('booking-phone')).value.trim();
      const notes = (document.getElementById('booking-notes')).value.trim();

      const lines = [
        'Hello La Penzana del Merel! I would like to book a table:',
        `Name: ${name}`,
        `Guests: ${guests}`,
        `Date: ${date}`,
        `Time: ${time}`,
        `Phone: ${phone}`,
      ];

      if (notes) {
        lines.push(`Notes: ${notes}`);
      }

      const message = encodeURIComponent(lines.join('\n'));
      openExternalLink(`https://wa.me/${whatsappNumber}?text=${message}`);
      closeBooking();
      bookingForm.reset();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeChoice();
      closeBooking();
    });
  </script>

</BaseLayout>
