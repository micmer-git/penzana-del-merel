---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Marquee from '../components/Marquee.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'it' | 'en';
  canonical?: string;
  ogImage?: string;
  pageType?: 'website' | 'restaurant';
  currentPath?: string;
  bodyClass?: string;
  mainClass?: string;
}

const {
  title,
  description,
  lang = 'it',
  canonical,
  ogImage = '/og/default.jpg',
  pageType = 'website',
  currentPath = Astro.url.pathname,
  bodyClass = '',
  mainClass = '',
} = Astro.props;

const siteName = 'La Penzana del Merel';
const siteUrl = 'https://la-penzana-del-merel.pages.dev';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonicalUrl = canonical ?? `${siteUrl}${currentPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const itPath = currentPath.replace(/^\/en(\/.*)?$/, '$1').replace(/\/\/$/, '/') || '/';
const enPath = currentPath.startsWith('/en')
  ? currentPath
  : `/en${currentPath}`.replace(/\/\/$/, '/');
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="pizzeria d'asporto Val Seriana, pizzeria Media Valle Seriana, ristorante tipico bergamasco, pizza forno a legna Bergamo, cucina bergamasca Orezzo, pizzeria Gazzaniga, pizzeria Vertova, pizzeria Albino, pizzeria Clusone, ristorante Orezzo Val Seriana, casoncelli bergamaschi, trattoria Val Seriana, consegna pizza Val Seriana, pizza artigianale Bergamo, La Penzana del Merel, wood-fired pizza Bergamo Italy, authentic Italian pizzeria Val Seriana, restaurant Bergamo Alps, best pizza Val Seriana, Italian mountain restaurant, traditional Bergamo cuisine, pizzeria near Bergamo" />
  <meta name="geo.region" content="IT-BG" />
  <meta name="geo.placename" content="Orezzo, Val Seriana, Bergamo" />
  <meta name="geo.position" content="45.806;9.823" />
  <meta name="ICBM" content="45.806, 9.823" />
  <link rel="canonical" href={canonicalUrl} />

  <link rel="alternate" hreflang="it" href={`${siteUrl}${itPath}`} />
  <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
  <link rel="alternate" hreflang="x-default" href={`${siteUrl}${itPath}`} />

  <meta property="og:type" content={pageType === 'restaurant' ? 'restaurant.restaurant' : 'website'} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
  {lang === 'it' && <meta property="og:locale:alternate" content="en_US" />}
  {lang === 'en' && <meta property="og:locale:alternate" content="it_IT" />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  {pageType === 'restaurant' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Restaurant",
      "name": "La Penzana del Merel",
      "alternateName": "Penzana del Merel Orezzo",
      "description": lang === 'it'
        ? "Pizzeria d'asporto e ristorante tipico nella Media Valle Seriana, Bergamo. Forno a legna dal 1959. Pizza artigianale, casoncelli, cucina bergamasca. Consegna a domicilio Orezzo, Gazzaniga, Vertova, Albino."
        : "Family-run wood-fired pizzeria and traditional Bergamo restaurant in Val Seriana, Italian Alps. Authentic Italian pizza and local cuisine since 1959.",
      "image": `${siteUrl}/img/pizza_front.jpg`,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Via alla Chiesa, 4",
        "addressLocality": "Orezzo",
        "addressRegion": "BG",
        "postalCode": "24025",
        "addressCountry": "IT"
      },
      "telephone": "+39 035 712021",
      "url": `${siteUrl}/`,
      "menu": `${siteUrl}/menu/`,
      "servesCuisine": ["Pizza", "Italian", "Bergamasca", "Casoncelli", "Wood-fired Pizza"],
      "priceRange": "€€",
      "currenciesAccepted": "EUR",
      "paymentAccepted": "Cash, Credit Card",
      "acceptsReservations": true,
      "hasMenu": {
        "@type": "Menu",
        "name": "Menu La Penzana del Merel",
        "url": `${siteUrl}/menu/`,
        "hasMenuSection": [
          { "@type": "MenuSection", "name": "Pizze Classiche" },
          { "@type": "MenuSection", "name": "Pizze Sfiziose" },
          { "@type": "MenuSection", "name": "Cucina Bergamasca" },
          { "@type": "MenuSection", "name": "Dolci della Casa" }
        ]
      },
      "areaServed": [
        { "@type": "City", "name": "Bergamo" },
        { "@type": "Place", "name": "Val Seriana" },
        { "@type": "Place", "name": "Media Valle Seriana" },
        { "@type": "Place", "name": "Orezzo" },
        { "@type": "Place", "name": "Gazzaniga" },
        { "@type": "Place", "name": "Vertova" },
        { "@type": "Place", "name": "Albino" },
        { "@type": "Place", "name": "Clusone" },
        { "@type": "Place", "name": "Nembro" },
        { "@type": "Place", "name": "Selvino" }
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 45.806,
        "longitude": 9.823
      },
      "foundingDate": "1959",
      "sameAs": [
        "https://www.facebook.com/LaPenzanaDelMerel/",
        "https://www.instagram.com/lapenzanadelmerel/"
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.5",
        "reviewCount": "120",
        "bestRating": "5"
      },
      "potentialAction": {
        "@type": "OrderAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${siteUrl}/menu/`,
          "actionPlatform": "http://schema.org/DesktopWebPlatform"
        },
        "deliveryMethod": "http://purl.org/goodrelations/v1#DeliveryModePickUp"
      }
    })} />
  )}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "La Penzana del Merel",
    "@id": `${siteUrl}/#localbusiness`,
    "url": `${siteUrl}/`,
    "telephone": "+39 035 712021",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Via alla Chiesa, 4",
      "addressLocality": "Orezzo",
      "addressRegion": "BG",
      "postalCode": "24025",
      "addressCountry": "IT"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 45.806,
      "longitude": 9.823
    },
    "hasMap": "https://maps.google.com/?q=45.806,9.823"
  })} />
</head>
<body class={bodyClass}>
  <a href="#main-content" class="sr-only" style="position:fixed;top:0;left:0;z-index:9999;background:var(--accent-gold);padding:0.5rem 1rem;">Skip to content</a>
  <Header lang={lang} currentPath={currentPath} />
  <main id="main-content" class={mainClass}>
    <slot />
  </main>
  <div class="layout-bottom-marquee">
    <Marquee lang={lang} />
  </div>
  <Footer lang={lang} />

  <script>
    const initRevealObserver = () => {
      const items = document.querySelectorAll('.reveal');
      if (!items.length) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach((el) => el.classList.add('visible'));
        return;
      }

      if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('visible'));
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -8% 0px' });

      items.forEach((el) => observer.observe(el));
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRevealObserver, { once: true });
    } else {
      initRevealObserver();
    }
  </script>
</body>
</html>
